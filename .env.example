# Copy to .env and fill in. Never commit .env.

# Supabase Postgres (Mumbai). Pooled connection for the app, direct for migrations.
DATABASE_URL=
DIRECT_URL=

# Signs session cookies. At least 32 random characters, e.g. `openssl rand -base64 48`.
SESSION_SECRET=

# Google Gemini, for plain-language summaries.
GEMINI_API_KEY=

# Demo front-desk login created by `npm run db:seed` (password: 12+ characters).
SEED_STAFF_EMAIL=
SEED_STAFF_PASSWORD=

# Public base URL used in report links, e.g. http://localhost:3000 or https://your-app.vercel.app
APP_URL=

# "true" turns on demo tools (demo phone) and stores message bodies in the outbox. Leave unset in production.
DEMO_MODE=
